<Project>
  <PropertyGroup>
    <RootNamespace>HumbleEngine.$(MSBuildProjectName)</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="HumbleEngine.Core.HelperFunctions" Static="true" />
  </ItemGroup>
</Project>
